<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:MitosScope.App.ViewModels.Panels"
             x:Class="MitosScope.App.Views.Panels.AccountPanelView"
             x:DataType="panels:AccountPanelViewModel">
    <StackPanel Spacing="4">
        <TextBlock Classes="muted" Text="No client connected"
                   IsVisible="{Binding !Tracker.HasCurrent}" />

        <StackPanel Spacing="4" IsVisible="{Binding Tracker.Current.Account, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <TextBlock Classes="title" Text="{Binding Tracker.Current.DisplayName}" />

            <TextBlock FontSize="12">
                <Run Text="Level " />
                <Run Text="{Binding Tracker.Current.Account.Level}" FontWeight="SemiBold" />
                <Run Text="   " />
                <Run Text="{Binding Tracker.Current.ExpText}" Foreground="#A0FFFFFF" />
            </TextBlock>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Tracker.Current.ExpProgress}" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2" Margin="0,4,0,0">
                <TextBlock Grid.Row="0" Classes="label" Text="Coins" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Tracker.Current.Account.Coins, StringFormat='{}{0:N0}'}" />

                <TextBlock Grid.Row="1" Classes="label" Text="Rating" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Tracker.Current.RatingText}" />

                <TextBlock Grid.Row="2" Classes="label" Text="Guild" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Tracker.Current.GuildText}" />

                <TextBlock Grid.Row="3" Classes="label" Text="Server" />
                <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Tracker.Current.ServerText}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
