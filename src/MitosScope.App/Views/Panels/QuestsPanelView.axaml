<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="using:MitosScope.Core.Api"
             xmlns:panels="using:MitosScope.App.ViewModels.Panels"
             x:Class="MitosScope.App.Views.Panels.QuestsPanelView"
             x:DataType="panels:QuestsPanelViewModel">
    <UserControl.Styles>
        <Style Selector="StackPanel.done">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="title" Margin="0,0,0,4">
            <Run Text="Quests " />
            <Run Text="{Binding Tracker.Current.OpenQuestCount, FallbackValue=0}" Foreground="#A0FFFFFF" FontSize="12" />
            <Run Text="open" Foreground="#A0FFFFFF" FontSize="12" />
        </TextBlock>

        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No client connected"
                   IsVisible="{Binding !Tracker.HasCurrent}" />

        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Tracker.Current.Quests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="api:Quest">
                        <!-- Completed quests are dimmed. -->
                        <StackPanel Margin="0,0,0,6" Spacing="2" Classes.done="{Binding IsDone}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Text}" />
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFD060"
                                           VerticalAlignment="Top" Text="{Binding RewardText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ProgressBar Minimum="0" Maximum="{Binding Target}" Value="{Binding Current}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="11" Foreground="#A0FFFFFF">
                                    <Run Text="{Binding Current}" /><Run Text="/" /><Run Text="{Binding Target}" />
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
